# ==============================================================================
# AppControl v1.0 — Configurações de Ambiente (Frontend)
# ==============================================================================

# 1. Supabase (Autenticação e Banco de Dados Client-side)
# URL pública do projeto Supabase (ex: https://xxxx.supabase.co)
VITE_SUPABASE_URL="https://sua-url-do-supabase.supabase.co"

# Chave Anônima (Anon Public Key) para chamadas client-side
VITE_SUPABASE_ANON_KEY="sua-anon-key-publica-do-supabase"

# 2. Backend REST API
# URL base do servidor FastAPI
# Local: http://localhost:8000
# Produção: https://appcontrol-backend-production.up.railway.app
VITE_API_URL="http://localhost:8000"
