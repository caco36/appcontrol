# ==============================================================================
# AppControl v1.0 — Configurações de Ambiente (Backend)
# ==============================================================================

# 1. Supabase (Banco de Dados e Autenticação)
# URL da API do projeto Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL="https://sua-url-do-supabase.supabase.co"

# Chave de Serviço (Service Role Key) com permissões administrativas de bypass de RLS
SUPABASE_SERVICE_KEY="sua-service-role-key-do-supabase"

# 2. Provedores de Inteligência Artificial
# Google Gemini API Key (Obrigatória para o Módulo Extrator IA e Geradores)
GEMINI_API_KEY="sua-chave-api-do-google-gemini"

# Anthropic API Key (Opcional/Legado para Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="sua-chave-api-da-anthropic"

# 3. Configurações da Aplicação REST (FastAPI)
PORT=8000
ENVIRONMENT="production" # 'development' ou 'production'
CORS_ORIGINS="http://localhost:5173,https://appcontrol.vercel.app"
